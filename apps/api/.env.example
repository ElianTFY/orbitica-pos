# ORBÍTICA POS — Environment Variables Template

# Entorno de Ejecución
ENVIRONMENT=production
DEBUG=false
APP_NAME=Orbítica POS API
API_V1_STR=/api/v1
PORT=8000

# Base de Datos PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:secure_password@localhost:5432/orbitica_pos
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:secure_password@localhost:5432/orbitica_pos

# Seguridad y Criptografía
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string
FERNET_KEY=change_this_to_a_32_byte_base64_fernet_key_for_p12_encryption
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (JSON Array)
CORS_ORIGINS=["https://web-mocha-gamma-es6gomw437.vercel.app","http://localhost:3000"]

# Proveedor del Sistema (Hacienda Costa Rica v4.4)
HACIENDA_SYSTEM_NAME=ORBITICA_POS
HACIENDA_SYSTEM_VERSION=1.0.0
HACIENDA_PROVIDER_TAX_ID=3101000000
