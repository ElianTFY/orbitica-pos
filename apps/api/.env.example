# ==============================================================================
# ORBÍTICA POS — API BACKEND (.env.example)
# ==============================================================================
ENVIRONMENT=development

DATABASE_URL=sqlite+aiosqlite:///./orbitica_pos.db
SYNC_DATABASE_URL=sqlite:///./orbitica_pos.db

# Hosting PostgreSQL accepts postgres:// or postgresql:// and selects asyncpg.
# When omitted, SYNC_DATABASE_URL is derived from a PostgreSQL DATABASE_URL.
# For LOCAL in a cloud host, this directory must be on a persistent volume.
STORAGE_TYPE=LOCAL
LOCAL_STORAGE_DIR=./storage
# Optional S3 / Cloudflare R2 (use STORAGE_TYPE=S3 or R2):
# S3_BUCKET_NAME=your-private-bucket
# S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

JWT_SECRET_KEY=dev_secret_key_change_in_production_orbitica_pos_2026_super_secure
ENCRYPTION_MASTER_KEY=DEV_MASTER_KEY_32_BYTES_FOR_DEV_ONLY_123456=

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

SOFTWARE_PROVIDER_TAX_ID=3101000000
SOFTWARE_PROVIDER_TAX_ID_TYPE=02
SOFTWARE_PROVIDER_NAME=ORBITICA STUDIO S.A.

HACIENDA_LIVE_EMISSION_ENABLED=false
HACIENDA_SANDBOX_VALIDATED=false
FRONTEND_URL=https://tu-dominio.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=facturacion@tu-dominio.com
SMTP_PASSWORD=change_me
SMTP_TLS=true
COOKIE_SECURE=true
COOKIE_SAMESITE=none
