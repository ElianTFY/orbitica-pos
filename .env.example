# ORBÍTICA POS - Environment Variables

ENVIRONMENT=development
PROJECT_NAME="ORBÍTICA POS API"

# Security & Secrets
JWT_SECRET_KEY=generate_a_minimum_32_chars_random_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/orbitica_pos
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbitica_pos

# Frontend & CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://orbitica-pos.vercel.app"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Costa Rica Regional Defaults
DEFAULT_CURRENCY=CRC
DEFAULT_TIMEZONE=America/Costa_Rica
