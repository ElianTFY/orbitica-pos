# ==============================================================================
# ORBÍTICA POS — ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env.example)
# ==============================================================================
# Copia este archivo a .env antes de arrancar en desarrollo o producción.
# En producción, todos los valores marcados como OBLIGATORIO deben configurarse con
# secretos criptográficamente seguros. El sistema abortará el arranque si detecta
# valores predeterminados o inseguros.
# ==============================================================================

# Entorno: development | staging | production
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL 16 (OBLIGATORIO)
# ------------------------------------------------------------------------------
POSTGRES_USER=orbitica
POSTGRES_PASSWORD=CambiarPorContrasenaSeguraDePostgres2026!
POSTGRES_DB=orbitica_pos
DATABASE_URL=postgresql+asyncpg://orbitica:CambiarPorContrasenaSeguraDePostgres2026!@postgres:5432/orbitica_pos
SYNC_DATABASE_URL=postgresql://orbitica:CambiarPorContrasenaSeguraDePostgres2026!@postgres:5432/orbitica_pos

# ------------------------------------------------------------------------------
# 2. Seguridad Criptográfica & JWT (OBLIGATORIO)
# ------------------------------------------------------------------------------
# Debe ser un string aleatorio de mínimo 32 caracteres (ej: openssl rand -hex 32)
JWT_SECRET_KEY=cambiar_por_clave_secreta_jwt_minimo_32_caracteres_segura_2026
# Clave Fernet de 32 bytes en base64 para cifrado de certificados .p12 y PINs
ENCRYPTION_MASTER_KEY=DEV_MASTER_KEY_32_BYTES_FOR_DEV_ONLY_123456=

# ------------------------------------------------------------------------------
# 3. CORS & Dominios Autorizados (OBLIGATORIO)
# ------------------------------------------------------------------------------
# Lista JSON o separada por comas de orígenes permitidos
BACKEND_CORS_ORIGINS=["https://app.orbiticapos.com","https://orbitica-pos.vercel.app"]

# ------------------------------------------------------------------------------
# 4. Proveedor del Sistema (Costa Rica v4.4 - OBLIGATORIO)
# ------------------------------------------------------------------------------
SOFTWARE_PROVIDER_TAX_ID=3101000000
SOFTWARE_PROVIDER_TAX_ID_TYPE=02
SOFTWARE_PROVIDER_NAME=ORBITICA STUDIO S.A.

# ------------------------------------------------------------------------------
# 5. Redis & Coordinación (Opcional en dev, recomendado en prod)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 6. Barreras de Seguridad Fiscal
# ------------------------------------------------------------------------------
# Solo activar tras validar exitosamente en ATV Sandbox
HACIENDA_LIVE_EMISSION_ENABLED=false
HACIENDA_SANDBOX_VALIDATED=false

# ------------------------------------------------------------------------------
# 7. Frontend URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FASTAPI_BACKEND_URL=http://api:8000
